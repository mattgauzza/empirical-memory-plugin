# The manifest generator writes LF. Without this, a Windows checkout converts the
# generated JSON to CRLF and `build-manifests.mjs --check` reports false drift
# locally while passing in CI.
*.json text eol=lf
*.mjs  text eol=lf
*.yml  text eol=lf

# Build and validation tools are not part of the installed plugin.
scripts export-ignore

# Exclude OS metadata from GitHub/source archives, even if force-added to Git.
.DS_Store export-ignore
**/.DS_Store export-ignore
Thumbs.db export-ignore
**/Thumbs.db export-ignore
Desktop.ini export-ignore
**/Desktop.ini export-ignore
__MACOSX export-ignore
**/__MACOSX export-ignore
._* export-ignore
**/._* export-ignore
